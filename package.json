{
  "name": "jsonplaceholder-todo-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only MCP server for fetching JSONPlaceholder todos",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:netlify": "npx --yes netlify-cli@27.8.0 dev --offline --no-open",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.netlify.json",
    "build:netlify": "npx --yes netlify-cli@27.8.0 build --offline",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@netlify/functions": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
